{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform/schemas/policy/policy-record.schema.json",
  "title": "PolicyRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_name",
    "headend",
    "endpoint",
    "color",
    "candidate_paths",
    "intent_state",
    "observed_state",
    "support_state",
    "health_state",
    "source",
    "notes"
  ],
  "properties": {
    "policy_id": { "type": "string" },
    "policy_name": { "type": "string" },
    "headend": { "type": "string" },
    "endpoint": { "type": "string" },
    "color": { "type": "integer" },
    "candidate_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path_state", "notes"],
        "properties": {
          "name": { "type": "string" },
          "path_state": {
            "type": "string",
            "enum": ["active", "inactive", "unknown"]
          },
          "preference": { "type": "integer" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "intent_state": {
      "type": "string",
      "enum": ["declared", "unknown"]
    },
    "observed_state": {
      "type": "string",
      "enum": ["active", "inactive", "degraded", "unknown"]
    },
    "support_state": {
      "type": "string",
      "enum": [
        "supported",
        "partially_supported",
        "unsupported",
        "unknown",
        "not_implemented_in_platform"
      ]
    },
    "health_state": {
      "type": "string",
      "enum": ["healthy", "degraded", "down", "unknown"]
    },
    "source": { "type": "string" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
