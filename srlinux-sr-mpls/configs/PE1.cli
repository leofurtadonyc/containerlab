enter candidate

/system {
    name host-name PE1
    grpc-server mgmt {
        admin-state enable
        default-tls-profile true
        network-instance mgmt
        services [
            gnmi
            gnoi
            gnsi
        ]
    }
}

# * =========================================================
# * INTERFACES
# * =========================================================
# * NOTE:
# * - SR OS card/MDA/port breakout is not portable 1:1 to SR Linux.
# * - Adjust ethernet port names to the actual SR Linux platform.
# * - Below I map:
# *   1/1/c1/1 -> ethernet-1/1
# *   1/1/c2/1 -> ethernet-1/2
# *   1/1/c3/1 -> ethernet-1/3
# *   1/1/c5/1 -> ethernet-1/5
# * =========================================================
# */

interface system0 {
    admin-state enable
    subinterface 0 {
        admin-state enable
        ipv4 {
            address 100.65.255.12/32
        }
        ipv6 {
            address 2001:db8:65:255::12/128
        }
    }
}

interface ethernet-1/1 {
    admin-state enable
    description "Access toward CE services"
    mtu 9216

    subinterface 10 {
        admin-state enable
        ipv4 {
            address 172.17.0.2/30
        }
        vlan {
            encap {
                single-tagged {
                    vlan-id 10
                }
            }
        }
    }

    subinterface 20 {
        admin-state enable
        type bridged
        vlan {
            encap {
                single-tagged {
                    vlan-id 20
                }
            }
        }
    }

    subinterface 30 {
        admin-state enable
        type bridged
        vlan {
            encap {
                single-tagged {
                    vlan-id 30
                }
            }
        }
    }

    subinterface 40 {
        admin-state enable
        type bridged
        vlan {
            encap {
                single-tagged {
                    vlan-id 40
                }
            }
        }
    }

    subinterface 50 {
        admin-state enable
        type bridged
        vlan {
            encap {
                single-tagged {
                    vlan-id 50
                }
            }
        }
    }

    subinterface 60 {
        admin-state enable
        type bridged
        vlan {
            encap {
                single-tagged {
                    vlan-id 60
                }
            }
        }
    }

    subinterface 70 {
        admin-state enable
        ipv4 {
            address 65.65.0.9/30
        }
        ipv6 {
            address 2001:db8:b::1/126
        }
        vlan {
            encap {
                single-tagged {
                    vlan-id 70
                }
            }
        }
    }
}

interface ethernet-1/2 {
    admin-state enable
    description "type=p peer_device=P1 peer_interface=to-PE2"
    mtu 9216
    subinterface 0 {
        admin-state enable
        ipv4 {
            address 100.65.0.9/30
        }
        ipv6 {
            address 2001:db8:65::9/126
        }
    }
}

interface ethernet-1/3 {
    admin-state enable
    description "type=p peer_device=P2 peer_interface=to-PE2"
    mtu 9216
    subinterface 0 {
        admin-state enable
        ipv4 {
            address 100.65.0.13/30
        }
        ipv6 {
            address 2001:db8:65::13/126
        }
    }
}

interface ethernet-1/5 {
    admin-state enable
    description "type=noc peer_device=NOC-R1 peer_interface=to-PE2-vlan50"
    mtu 9216
    subinterface 50 {
        admin-state enable
        ipv4 {
            address 172.31.50.1/30
        }
        vlan {
            encap {
                single-tagged {
                    vlan-id 50
                }
            }
        }
    }
}

# /* =========================================================
#  * ROUTING POLICY
#  * =========================================================
#  */
routing-policy {
    community-set RT-101 {
        member [ target:64515:101 ]
    }
    community-set RT-102 {
        member [ target:64515:102 ]
    }
    community-set RT-103 {
        member [ target:64515:103 ]
    }
    community-set RT-104 {
        member [ target:64515:104 ]
    }

    policy BGP-EXPORT-VPRN10-TO-CE {
        default-action {
            policy-result reject
        }
        statement 10 {
            match {
                protocol bgp
            }
            action {
                policy-result accept
            }
        }
    }

    policy BGP-IMPORT-VPRN10-FROM-CE {
        default-action {
            policy-result reject
        }
        statement 10 {
            match {
                protocol bgp
            }
            action {
                policy-result accept
            }
        }
    }

    policy VRF-EXPORT-CE-BGP {
        default-action {
            policy-result reject
        }
        statement 10 {
            match {
                protocol bgp
            }
            action {
                policy-result accept
                bgp {
                    communities {
                        add RT-102
                    }
                }
            }
        }
        statement 20 {
            match {
                protocol local
            }
            action {
                policy-result accept
                bgp {
                    communities {
                        add RT-102
                    }
                }
            }
        }
    }

    policy VRF-IMPORT-PE2 {
        default-action {
            policy-result reject
        }
        statement 10 {
            match {
                bgp {
                    community-set RT-101
                }
            }
            action {
                policy-result accept
            }
        }
        statement 20 {
            match {
                bgp {
                    community-set RT-104
                }
            }
            action {
                policy-result accept
            }
        }
    }
}

#     /* Placeholder:
#      * SR OS rib-management import/export between ipv6 and label-ipv6
#      * is not translated here 1:1. Implement BGP-LU policy explicitly
#      * if you really need IPv6<->label-ipv6 table leaking on SR Linux.
#      */

# /* =========================================================
#  * DEFAULT NETWORK INSTANCE / UNDERLAY
#  * =========================================================
#  */

network-instance default {
    type default
    admin-state enable
    interface system0.0 {
    }
    interface ethernet-1/2.0 {
    }
    interface ethernet-1/3.0 {
    }
    protocols {
        ospf {
            instance 0 {
                admin-state enable
                version ospf-v2
                router-id 100.65.255.12

                area 0.0.0.0 {
                    interface system0.0 {
                        passive true
                    }
                    interface ethernet-1/2.0 {
                        interface-type point-to-point
                    }
                    interface ethernet-1/3.0 {
                        interface-type point-to-point
                    }
                }
            }
# SR OS OSPF traffic-engineering and OSPF segment-routing do not map 1:1 to SR Linux.
# SR Linux currently supports TE extensions only with IS-IS, and SR prefix-SID configuration
# is modeled differently. Keep OSPF here as plain underlay reachability only.

#                segment-routing {
#                    admin-state enable
#                    locator default
#                    prefix-sid {
#                        interface system0.0 {
#                            index 12
#                            node-sid true
#                        }
#                    }
#                }
#            }
        ldp {
            admin-state enable
            discovery {
                interfaces {
                    interface ethernet-1/2.0 {
                        ipv4 {
                            admin-state enable
                        }
                        ipv6 {
                            admin-state enable
                        }
                    }
                    interface ethernet-1/3.0 {
                        ipv4 {
                            admin-state enable
                        }
                        ipv6 {
                            admin-state enable
                        }
                    }
                }
            }
        }

        bgp {
            admin-state enable
            autonomous-system 64515
            router-id 100.65.255.12
            rapid-withdrawal true

            graceful-restart {
                admin-state enable
            }

            group IBGP-RR {
                admin-state enable
                peer-as 64515
                export-policy [ ]
                import-policy [ ]

                afi-safi ipv4-unicast {
                    admin-state enable
                }
                afi-safi ipv6-unicast {
                    admin-state enable
                }
                afi-safi ipv4-labeled-unicast {
                    admin-state enable
                }
                afi-safi ipv6-labeled-unicast {
                    admin-state enable
                }
                afi-safi evpn {
                    admin-state enable
                }
                afi-safi l3vpn-ipv4-unicast {
                    admin-state enable
                }
                afi-safi l3vpn-ipv6-unicast {
                    admin-state enable
                }
                afi-safi route-target {
                    admin-state enable
                }
                afi-safi bgp-ls {
                    admin-state enable
                }

                transport {
                    local-address 100.65.255.12
                }

                route-reflector {
                    client true
                }

                next-hop-self true
            }

            neighbor 100.65.255.3 {
                admin-state enable
                description "iBGP_to_P3"
                peer-group IBGP-RR
            }

            neighbor 100.65.255.4 {
                admin-state enable
                description "iBGP_to_P4"
                peer-group IBGP-RR
            }

#           /* BGP next-hop/tunnel-resolution equivalents */
            next-hop-resolution {
                ipv4-unicast {
                    allowed-tunnel-types [ ldp ospf-segment-routing sr-mpls-policy ]
                }
                ipv6-unicast {
                    allowed-tunnel-types [ ldp ospf-segment-routing sr-mpls-policy ]
                }
                ipv4-labeled-unicast {
                    allowed-tunnel-types [ ldp ospf-segment-routing sr-mpls-policy ]
                }
                ipv6-labeled-unicast {
                    allowed-tunnel-types [ ldp ospf-segment-routing sr-mpls-policy ]
                }
                l3vpn-ipv4-unicast {
                    allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                }
                l3vpn-ipv6-unicast {
                    allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                }
                evpn {
                    allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                }
            }
        }
    }

    mpls {
        admin-state enable

        static-label-block SRGB {
            start-label 100000
            end-label 100999
        }

        static-label-block SRLB-SRTE {
            start-label 200000
            end-label 200099
        }
    }

    traffic-engineering {
        ipv4-te-router-id 100.65.255.12
        ipv6-te-router-id 2001:db8:65:255::12

        interface ethernet-1/2.0 {
            admin-group [ black blue cyan purple ]
        }
        interface ethernet-1/3.0 {
            admin-group [ black blue cyan purple ]
        }

        sr-policy PE2-to-PE4-SRTE {
            admin-state enable
            color 100
            endpoint 100.65.255.14
            binding-sid {
                mpls-label 200012
            }
            candidate-paths {
                candidate-path 100 {
                    preference 100
                    explicit-segment-list 1 {
                        admin-state enable
                        segment 1 {
                            mpls-label 100001
                        }
                        segment 2 {
                            mpls-label 100007
                        }
                        segment 3 {
                            mpls-label 100014
                        }
                    }
                }
            }
        }

#         /* SR OS dynamic CSPF LSP "SRTE-PE2-PE4-NO-RED" does not map
#          * 1:1 to the old RSVP/SR-TE service-LSP model. Rebuild it here
#          * as an SR policy with constraints if you need active steering.
#          */
    }
}

# /* =========================================================
#  * IP-VRF SERVICES
#  * =========================================================
#  */

network-instance CUST-B-L3VPN {
    type ip-vrf
    admin-state enable
    interface ethernet-1/1.10

    protocols {
        bgp-vpn {
            bgp-instance 1 {
                admin-state enable
                route-distinguisher 64515:1012

                route-target {
                    import-rt target:64515:101
                    import-rt target:64515:104
                    export-rt target:64515:102
                }

                mpls {
                    admin-state enable
                    next-hop-resolution {
                        allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                    }
                }

                import-policy [ VRF-IMPORT-PE2 ]
                export-policy [ VRF-EXPORT-CE-BGP ]
            }
        }

        bgp {
            admin-state enable
            autonomous-system 64515
            router-id 100.65.255.12

            group CE-B1 {
                admin-state enable
                peer-as 65002
                as-path-options {
                    replace-peer-as true
                }
                transport {
                    local-address 172.17.0.2
                }
                export-policy [ BGP-EXPORT-VPRN10-TO-CE ]
                import-policy [ BGP-IMPORT-VPRN10-FROM-CE ]

                afi-safi ipv4-unicast {
                    admin-state enable
                }
            }

            neighbor 172.17.0.1 {
                admin-state enable
                peer-group CE-B1
            }
        }
    }

    interface ethernet-1/1.10 {
        ipv4 {
            address 172.17.0.2/30
        }
        vlan {
            encap {
                single-tagged {
                    vlan-id 10
                }
            }
        }
    }
}

network-instance CUST-NOC-L3VPN {
    type ip-vrf
    admin-state enable
    interface ethernet-1/5.50

    protocols {
        bgp-vpn {
            bgp-instance 1 {
                admin-state enable
                route-distinguisher 64515:1512

                route-target {
                    import-rt target:64515:150
                    export-rt target:64515:150
                }

                mpls {
                    admin-state enable
                    next-hop-resolution {
                        allowed-tunnel-types [ ldp ospf-segment-routing ]
                    }
                }
            }
        }

        bgp {
            admin-state enable
            autonomous-system 64515
            router-id 100.65.255.12

            group CE-NOC-R1 {
                admin-state enable
                peer-as 65010
                as-path-options {
                    replace-peer-as true
                }
                transport {
                    local-address 172.31.50.1
                }
                export-policy [ BGP-EXPORT-VPRN10-TO-CE ]
                import-policy [ BGP-IMPORT-VPRN10-FROM-CE ]

                afi-safi ipv4-unicast {
                    admin-state enable
                }
            }

            neighbor 172.31.50.2 {
                admin-state enable
                peer-group CE-NOC-R1
            }
        }
    }
}

# /* =========================================================
#  * L2 SERVICES
#  * =========================================================
#  * IMPORTANT:
#  * These are intent-preserving redesigns, not literal SR OS syntax conversions.
#  */

# /* VLAN40 : EVPN-MPLS L2 service */
network-instance CUST-B-BGP-EVPN {
    type mac-vrf
    admin-state enable
    interface ethernet-1/1.40

    protocols {
        bgp-evpn {
            bgp-instance 1 {
                admin-state enable
                evi 40
                encapsulation-type mpls
                mpls {
                    next-hop-resolution {
                        allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                    }
                }
            }
        }
    }
}

# /* VLAN60 : EVPN-MPLS L2 service */
network-instance CUST-B-EVPN {
    type mac-vrf
    admin-state enable
    interface ethernet-1/1.60

    protocols {
        bgp-evpn {
            bgp-instance 1 {
                admin-state enable
                evi 160
                encapsulation-type mpls
                mpls {
                    next-hop-resolution {
                        allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                    }
                }
                route-target {
                    import-rt target:64515:60
                    export-rt target:64515:60
                }
                route-distinguisher 64515:60
            }
        }
    }
}

# /* VLAN20 : replace SR OS EPIPE/LDP with VPWS pseudowire model */
network-instance CUST-B-VPWS-LDP {
    type vpws
    admin-state enable
    interface ethernet-1/1.20 {
        connection-point local-ac
    }

    connection-point local-ac { }
    connection-point remote-pw { }

    protocols {
        pseudowire {
            pseudowire pw1 {
                connection-point remote-pw
                pw-type vlan
                signaling tldp
                pw-tunnel 12141
                vc-id 20
                control-word false
            }
            pseudowire pw2 {
                connection-point remote-pw
                pw-type vlan
                signaling tldp
                pw-tunnel 12142
                vc-id 21
                control-word false
            }
        }
    }
}

# /* VLAN30 : replace SR OS VPLS/LDP with MAC-VRF + pseudowire */
network-instance CUST-B-VPLS-LDP {
    type mac-vrf
    admin-state enable
    interface ethernet-1/1.30

    connection-point pw-primary { }
    connection-point pw-backup  { }

    protocols {
        pseudowire {
            pseudowire pw31 {
                connection-point pw-primary
                pw-type vlan
                signaling tldp
                pw-tunnel 12141
                vc-id 31
            }
            pseudowire pw32 {
                connection-point pw-backup
                pw-type vlan
                signaling tldp
                pw-tunnel 12142
                vc-id 32
            }
        }
    }
}

# /* VLAN50 : SR OS BGP-VPLS AD has no clean 1:1 SR Linux equivalent.
#  * Recommended redesign: EVPN-MPLS MAC-VRF instead of legacy BGP-VPLS.
#  */
network-instance CUST-B-VPLS-BGPAD {
    type mac-vrf
    admin-state enable
    interface ethernet-1/1.50

    protocols {
        bgp-evpn {
            bgp-instance 1 {
                admin-state enable
                evi 50
                encapsulation-type mpls
                route-distinguisher 64515:50
                route-target {
                    import-rt target:64515:50
                    export-rt target:64515:50
                }
                mpls {
                    next-hop-resolution {
                        allowed-tunnel-types [ bgp ldp ospf-segment-routing sr-mpls-policy ]
                    }
                }
            }
        }
    }
}

