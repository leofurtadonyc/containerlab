# Containerlab runtime artifacts
clab-*/
*__clabtmp*
*.log

# Generated per-run inventories / ansible
inventory.yml
ansible-inventory.yml

# Local tooling / OS
.DS_Store
Thumbs.db

# Secrets / creds
*.key
*.pem
*.crt
*.pfx
*.env

# Python local env/cache
automation/.venv/
automation/src/**/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
automation/src/netlab_automation.egg-info/
*.egg-info/

# netlab generated outputs
automation/artifacts/
automation/baselines/

# optional coverage outputs
.coverage
htmlcov/

# license files
license/
license.txt

# Images
images/

# Frontend local dependencies / build outputs
**/node_modules/
**/.vite/
**/dist/
**/build/
npm-debug.log*

# Platform runtime data mounts
platform/grafana/data/*
!platform/grafana/data/.gitignore
platform/prometheus/data/*
!platform/prometheus/data/.gitignore
platform/postgres/data/*
!platform/postgres/data/.gitignore
!platform/postgres/data/.gitkeep

# Not interesting
agent/
temp/
wiki/
